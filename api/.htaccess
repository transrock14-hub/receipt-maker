RewriteEngine On

# Never serve secrets or local data as static downloads
<FilesMatch "(?i)^(config\.local\.php|config\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)\.local\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(sqlite|sql|env|log)$">
  Require all denied
</FilesMatch>

# Block direct browsing of data/ backups
RewriteRule ^(data|backups)(/|$) - [F,L]

# Route all non-file requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
